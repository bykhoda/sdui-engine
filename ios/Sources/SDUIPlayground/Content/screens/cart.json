          {
            "type": "vstack",
            "spacing": "$token.spacing.sm",
            "alignment": "leading",
            "modifiers": {
              "size": {
                "width": {
                  "mode": "fill"
                }
              },
              "padding": "$token.spacing.lg",
              "background": "$token.color.surface",
              "cornerRadius": "$token.radius.lg",
              "animation": { "curve": "spring" }
