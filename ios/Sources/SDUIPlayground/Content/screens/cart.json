                  {
                    "type": "hstack", "alignment": "center", "spacing": 4,
                    "visibleWhen": { "equals": ["$state.promo", "true"] },
                    "modifiers": { "padding": { "leading": "$token.spacing.md", "trailing": "$token.spacing.md", "top": "$token.spacing.sm", "bottom": "$token.spacing.sm" }, "background": "$token.color.primary", "cornerRadius": "$token.radius.pill", "onTap": { "action": "sequence", "actions": [ { "action": "setState", "key": "promo", "value": false }, { "action": "haptic", "style": "light" } ] } },
