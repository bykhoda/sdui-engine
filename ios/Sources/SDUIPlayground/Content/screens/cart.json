                "type": "hstack",
                "children": [
                  {
                    "type": "text",
                    "value": "Total",
                    "style": "$token.typography.headline",
                    "color": "$token.color.textPrimary"
                  },
                  {
                    "type": "spacer"
                  },
                  {
                    "type": "text",
                    "value": "$237.00",
                    "style": "$token.typography.title2",
                    "color": "$token.color.textPrimary",
                    "visibleWhen": {
                      "equals": [
                        "$state.cableRemoved",
                        "false"
                      ]
                    }
                  },
                  {
                    "type": "text",
                    "value": "$204.00",
                    "style": "$token.typography.title2",
                    "color": "$token.color.textPrimary",
                    "visibleWhen": {
                      "equals": [
                        "$state.cableRemoved",
                        "true"
                      ]
                    }
                  }
                ]
              }
            ]
          }
