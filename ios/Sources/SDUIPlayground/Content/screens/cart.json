              "action": "sequence",
              "actions": [
                {
                  "action": "haptic",
                  "style": "success"
                },
                {
                  "action": "showToast",
                  "message": "Order placed"
                }
              ]
            }
          },
          {
            "type": "text",
            "value": "Free returns within 14 days. Taxes calculated at checkout.",
            "style": "$token.typography.caption",
            "color": "$token.color.textTertiary",
            "alignment": "center",
            "modifiers": {
              "size": {
                "width": {
                  "mode": "fill"
                }
              }
            }
          }
