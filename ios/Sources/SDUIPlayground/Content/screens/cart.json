                  {
                    "type": "spacer"
                  },
                  {
                    "type": "text",
                    "value": "Free",
                    "style": "$token.typography.body",
                    "color": "$token.color.success",
                    "visibleWhen": {
                      "equals": [
                        "$state.cableRemoved",
                        "false"
                      ]
                    }
                  },
                  {
                    "type": "text",
                    "value": "$5.00",
                    "style": "$token.typography.body",
                    "color": "$token.color.textPrimary",
                    "visibleWhen": {
                      "equals": [
                        "$state.cableRemoved",
                        "true"
                      ]
                    }
                  }
                ]
              },
