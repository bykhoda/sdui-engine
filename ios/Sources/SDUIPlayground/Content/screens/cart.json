{
  "version": "0.1",
  "screen": {
    "id": "cart",
    "teach": {
      "title": "Cart",
      "task": "Tap the trash on the cable to remove it — watch the total update instantly."
    },
    "state": {
      "cableRemoved": false,
      "promo": false,
      "giftWrap": false
    },
    "content": {
      "type": "vstack",
      "spacing": 0,
      "modifiers": { "size": { "width": { "mode": "fill" }, "height": { "mode": "fill" } } },
      "children": [
      {
      "type": "scroll",
      "modifiers": { "size": { "width": { "mode": "fill" }, "height": { "mode": "fill" } } },
      "child": {
        "type": "vstack",
        "spacing": "$token.spacing.lg",
        "alignment": "leading",
        "modifiers": {
          "padding": "$token.spacing.lg",
          "size": {
            "width": {
              "mode": "fill"
            }
          },
          "animation": {
            "curve": "spring"
          }
        },
        "children": [
          {
            "type": "vstack",
            "alignment": "leading",
            "spacing": "$token.spacing.xs",
