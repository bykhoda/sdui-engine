                    "modifiers": { "padding": { "leading": "$token.spacing.md", "trailing": "$token.spacing.md", "top": "$token.spacing.sm", "bottom": "$token.spacing.sm" }, "background": "$token.color.primarySoft", "cornerRadius": "$token.radius.pill", "onTap": { "action": "sequence", "actions": [ { "action": "setState", "key": "promo", "value": true }, { "action": "haptic", "style": "light" }, { "action": "showToast", "message": "Promo applied · -$20", "style": "success" } ] } }
