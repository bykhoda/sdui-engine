                "type": "hstack",
                "alignment": "center",
                "spacing": "$token.spacing.sm",
                "modifiers": { "size": { "width": { "mode": "fill" } } },
                "children": [
                  { "type": "icon", "name": "gift.fill", "color": "$token.color.textTertiary", "size": 16 },
                  { "type": "vstack", "alignment": "leading", "spacing": 1, "children": [
                    { "type": "text", "value": "Gift wrap", "style": "$token.typography.body", "color": "$token.color.textPrimary" },
                    { "type": "text", "value": "+$5.00", "style": "$token.typography.caption", "color": "$token.color.textTertiary" }
                  ] },
                  { "type": "spacer" },
                  { "type": "toggle", "bind": "giftWrap", "title": "" }
                ]
              }
            ]
