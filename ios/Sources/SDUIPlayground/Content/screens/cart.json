      }
      },
      {
        "type": "vstack",
        "alignment": "center",
        "spacing": "$token.spacing.sm",
        "ignoresSafeArea": true,
        "modifiers": {
          "size": { "width": { "mode": "fill" } },
          "padding": { "leading": "$token.spacing.lg", "trailing": "$token.spacing.lg", "top": "$token.spacing.md", "bottom": 40 },
