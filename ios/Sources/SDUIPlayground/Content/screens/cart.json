                  {
                    "type": "spacer"
                  },
                  {
                    "type": "text",
                    "value": "$237.00",
                    "style": "$token.typography.body",
                    "color": "$token.color.textPrimary",
                    "visibleWhen": {
                      "equals": [
                        "$state.cableRemoved",
                        "false"
                      ]
                    }
                  },
                  {
                    "type": "text",
                    "value": "$199.00",
                    "style": "$token.typography.body",
                    "color": "$token.color.textPrimary",
                    "visibleWhen": {
                      "equals": [
                        "$state.cableRemoved",
                        "true"
                      ]
                    }
                  }
                ]
              },
              {
                "type": "hstack",
                "children": [
                  {
                    "type": "text",
                    "value": "Shipping",
                    "style": "$token.typography.body",
                    "color": "$token.color.textSecondary"
