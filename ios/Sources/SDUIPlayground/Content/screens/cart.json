                                "action": "setState",
                                "key": "cableRemoved",
                                "value": true
                              },
                              {
                                "action": "haptic",
                                "style": "medium"
                              },
                              {
                                "action": "showToast",
                                "message": "Removed from bag"
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
