                          "actions": [
                            {
                              "action": "haptic",
                              "style": "medium"
                            },
                            {
                              "action": "showToast",
                              "message": "Deleted",
                              "style": "error"
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
                "children": [
                  {
                    "type": "icon",
                    "name": "checkmark.circle.fill",
                    "color": "$token.color.success",
                    "size": 26
                  },
                  {
                    "type": "vstack",
                    "alignment": "leading",
                    "spacing": 2,
                    "children": [
                      {
                        "type": "text",
                        "value": "Call Aizhan about the demo",
                        "style": "$token.typography.headline",
                        "color": "$token.color.textTertiary",
                        "lineLimit": 1
                      },
                      {
                        "type": "text",
                        "value": "Follow-up sent",
                        "style": "$token.typography.caption",
                        "color": "$token.color.textTertiary"
                      }
                    ]
                  },
                  {
                    "type": "spacer"
                  }
                ]
              },
              {
                "type": "button",
                "title": "Add task",
                "style": "$token.button.large",
                "icon": "plus",
                "modifiers": {
                  "size": {
                    "width": {
                      "mode": "fill"
                    }
                  },
                  "padding": {
                    "top": "$token.spacing.sm"
                  }
                },
                "onTap": {
                  "action": "sequence",
                  "actions": [
                    {
                      "action": "haptic",
                      "style": "light"
                    },
                    {
                      "action": "showToast",
                      "message": "New task"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    "title": "Tasks",
    "scrollBehavior": {
      "largeTitle": true,
      "subtitle": "Monday, July 20"
    },
    "toolbar": {
      "trailing": [
        {
          "icon": "magnifyingglass",
