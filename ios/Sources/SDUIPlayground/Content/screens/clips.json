{
  "version": "0.1",
  "screen": {
    "id": "clips",
    "chrome": "immersive",
    "teach": {
      "title": "Clips",
      "task": "Swipe up for the next clip, double-tap or tap the heart to like, and use the glass rail to comment or share."
    },
    "state": {
      "liked_c1": false, "likes_c1": "12.4K",
      "liked_c2": false, "likes_c2": "48.1K",
      "liked_c3": false, "likes_c3": "27.9K",
      "liked_c4": false, "likes_c4": "9,842",
      "liked_c5": false, "likes_c5": "63.5K"
    },
    "content": {
      "type": "clips",
      "modifiers": {
        "ignoresSafeArea": true,
        "size": {
          "width": { "mode": "fill" },
          "height": { "mode": "fill" }
        }
      },
      "pages": [
        {
          "id": "c1",
          "colors": ["#F7971E", "#C7305E", "#241023"],
          "author": "@nova.films",
          "caption": "Golden hour over the north ridge — one take, no filter.",
          "audio": "Original audio · Nova",
          "liked": "$state.liked_c1",
          "likes": "$state.likes_c1",
          "comments": "318",
          "shares": "1.2K",
          "onLike": {
            "action": "sequence",
            "actions": [
              { "action": "haptic", "style": "light" },
              { "action": "setState", "key": "liked_c1", "value": true },
              {
                "action": "request",
                "source": { "id": "likeClip", "service": "feed", "path": "/clips/c1/like", "method": "POST" },
                "onError": {
                  "action": "sequence",
                  "actions": [
                    { "action": "setState", "key": "liked_c1", "value": false },
                    { "action": "showToast", "message": "Couldn't like — try again", "style": "error" }
                  ]
                }
              }
            ]
          },
          "onComment": { "action": "navigate", "to": "comments", "transition": "sheet", "params": { "clipId": "c1" }, "sheet": { "detents": ["large"], "dragIndicator": true } },
          "onShare": { "action": "sequence", "actions": [ { "action": "haptic", "style": "light" }, { "action": "showToast", "message": "Share clip" } ] },
          "onMore": { "action": "sequence", "actions": [ { "action": "haptic", "style": "light" }, { "action": "showToast", "message": "More options" } ] }
        },
        {
          "id": "c2",
