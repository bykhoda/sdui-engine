                  "spacing": 2,
                  "modifiers": {
                    "padding": {
                      "leading": "$token.spacing.sm",
                      "trailing": "$token.spacing.sm",
                      "bottom": "$token.spacing.sm"
                    }
                  },
                  "children": [
