          },
          {
            "type": "picker",
            "bind": "layout",
            "style": "segmented",
            "modifiers": {
              "size": {
                "width": {
                  "mode": "fill"
                }
              }
            },
            "options": [
              {
                "label": "List",
                "value": "list"
              },
              {
                "label": "Grid",
                "value": "grid"
              }
            ]
          },
          {
            "type": "list",
            "items": "$state.rows",
            "spacing": "$token.spacing.sm",
            "visibleWhen": {
              "equals": [
                "$state.layout",
                "list"
              ]
            },
            "modifiers": {
              "size": {
                "height": {
                  "mode": "fixed",
                  "value": 520
                }
              },
              "animation": {
                "curve": "spring"
              }
            },
            "template": {
              "type": "hstack",
              "alignment": "center",
              "spacing": "$token.spacing.md",
              "modifiers": {
                "size": {
                  "width": {
                    "mode": "fill"
                  }
                },
                "padding": "$token.spacing.md",
                "background": "$token.color.surfaceElevated",
                "cornerRadius": "$token.radius.lg",
                "onTap": {
                  "action": "sequence",
                  "actions": [
                    {
                      "action": "haptic",
                      "style": "light"
                    },
                    {
                      "action": "showToast",
                      "message": "$item.title"
                    }
                  ]
                }
              },
              "visibleWhen": {
                "or": [
                  {
                    "equals": [
                      "$state.category",
                      "All"
                    ]
                  },
                  {
                    "equals": [
                      "$item.category",
                      "$state.category"
                    ]
                  }
                ]
              },
              "children": [
                {
                  "type": "image",
                  "source": "$item.image",
                  "loader": {
                    "placeholder": "skeleton",
                    "contentMode": "fill"
                  },
                  "modifiers": {
                    "size": {
                      "width": {
                        "mode": "fixed",
                        "value": 56
                      },
                      "height": {
                        "mode": "fixed",
                        "value": 56
                      }
                    },
                    "cornerRadius": "$token.radius.md"
                  }
                },
                {
                  "type": "vstack",
                  "alignment": "leading",
                  "spacing": "$token.spacing.xs",
                  "children": [
                    {
                      "type": "text",
                      "value": "$item.title",
                      "style": "$token.typography.headline",
                      "color": "$token.color.textPrimary",
                      "lineLimit": 1
                    },
                    {
                      "type": "hstack",
                      "alignment": "center",
                      "spacing": "$token.spacing.xs",
                      "children": [
                        {
                          "type": "icon",
                          "name": "clock",
                          "color": "$token.color.textSecondary",
                          "size": 13
                        },
                        {
                          "type": "text",
                          "value": "$item.time",
                          "style": "$token.typography.caption",
                          "color": "$token.color.textSecondary",
                          "lineLimit": 1
                        },
                        {
                          "type": "text",
                          "value": "·",
                          "style": "$token.typography.caption",
                          "color": "$token.color.textTertiary",
                          "lineLimit": 1
                        },
                        {
                          "type": "icon",
                          "name": "star.fill",
                          "color": "$token.color.warning",
                          "size": 12
                        },
                        {
                          "type": "text",
                          "value": "$item.rating",
                          "style": "$token.typography.caption",
                          "color": "$token.color.textSecondary",
                          "lineLimit": 1
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "spacer"
                },
                {
                  "type": "icon",
                  "name": "chevron.right",
                  "color": "$token.color.textTertiary",
                  "size": 14
                }
              ]
            }
