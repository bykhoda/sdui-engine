# Swift / SPM
ios/.build/
.build/
DerivedData/
.swiftpm/

# Xcode per-user state (the .xcodeproj itself is intentionally committed)
xcuserdata/
*.xcuserstate

# macOS
.DS_Store

# Node
node_modules/

# Android (Gradle)
android/.gradle/
android/build/
android/**/build/
android/local.properties

# Aurora OS (Qt/qmake) build output. resources.qrc + content-manifest.json ARE
# committed (generated by tools/gen_qrc.sh, small, reviewable).
aurora/RPMS/
aurora/build/
aurora/*.pro.user
aurora/Makefile
aurora/.qmake.stash
aurora/moc_*
aurora/*.o

# Editor / tooling local state
# Ignore the whole local Claude workspace: per-user settings, the preview
# launch config, and (critically) agent worktrees, which are full stale copies
# of the repo and must never be committed. Un-ignore a shared file explicitly if
# the team ever wants one (e.g. !.claude/settings.json).
.claude/
.idea/
*.iml

