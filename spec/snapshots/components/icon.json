{
  "version": "0.1",
  "screen": {
    "id": "card_icon",
    "title": "icon",
    "content": {
      "type": "vstack",
      "spacing": "$token.spacing.md",
      "alignment": "leading",
      "modifiers": { "padding": "$token.spacing.lg" },
      "children": [
        { "type": "text", "value": "icon — symbols, tint & size", "style": "$token.typography.caption", "color": "$token.color.textSecondary" },
        {
          "type": "hstack",
          "alignment": "center",
          "spacing": "$token.spacing.lg",
          "children": [
            { "type": "icon", "name": "house.fill", "color": "$token.color.textPrimary" },
            { "type": "icon", "name": "heart.fill", "color": "$token.color.error" },
            { "type": "icon", "name": "star.fill", "color": "$token.color.primary" },
            { "type": "icon", "name": "checkmark.seal.fill", "color": "$token.color.success" }
          ]
        },
        {
          "type": "hstack",
          "alignment": "center",
          "spacing": "$token.spacing.lg",
          "children": [
            { "type": "icon", "name": "bolt.fill", "color": "$token.color.primary", "size": 16 },
            { "type": "icon", "name": "bolt.fill", "color": "$token.color.primary", "size": 28 },
            { "type": "icon", "name": "bolt.fill", "color": "$token.color.primary", "size": 44 }
          ]
        }
      ]
    }
  }
}
