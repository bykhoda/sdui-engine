{
  "$comment": "The design system. Every screen reads $token.* — change these values (or generate them from Figma variables via spec/tools/figma-tokens.mjs) and ALL screens re-theme at once, on iOS, Android and Aurora. $env.theme=dark swaps to colorDark.",
  "color": {
    "primary": "#5B5BF0",
    "primarySoft": "#ECEBFF",
    "onPrimary": "#FFFFFF",
    "surface": "#F4F4F7",
    "surfaceElevated": "#FFFFFF",
    "textPrimary": "#0E0E12",
    "textSecondary": "#71717A",
    "textTertiary": "#B4B4BD",
    "separator": "#E7E7EC",
    "success": "#10B981",
    "successSoft": "#E7F8F1",
    "warning": "#E8890C",
    "warningSoft": "#FDEFDC",
    "error": "#E5484D",
    "errorSoft": "#FDECEC",
    "info": "#5B5BF0",
    "infoSoft": "#ECEBFF"
  },
  "colorDark": {
    "primary": "#9B9BFF",
    "primarySoft": "#20203E",
    "onPrimary": "#FFFFFF",
    "surface": "#151518",
    "surfaceElevated": "#202026",
    "textPrimary": "#F6F6F8",
    "textSecondary": "#9C9CA7",
    "textTertiary": "#5B5B66",
    "separator": "#2C2C34",
    "success": "#34D399",
    "successSoft": "#0F2A20",
    "warning": "#FBBF24",
    "warningSoft": "#2C2110",
    "error": "#FF6369",
    "errorSoft": "#301516",
    "info": "#9B9BFF",
    "infoSoft": "#20203E"
  },
  "spacing": { "xs": 6, "sm": 10, "md": 16, "lg": 22, "xl": 34 },
  "radius": { "sm": 10, "md": 16, "lg": 22, "pill": 999 },
  "typography": {
    "hero": { "size": 76, "weight": "bold" },
    "display": { "size": 44, "weight": "bold" },
    "largeTitle": { "size": 32, "weight": "bold" },
    "title2": { "size": 22, "weight": "bold" },
    "headline": { "size": 17, "weight": "semibold" },
    "body": { "size": 17, "weight": "regular" },
    "subheadline": { "size": 15, "weight": "regular" },
    "caption": { "size": 12, "weight": "medium" }
  },
  "button": {
    "primary": { "background": "$token.color.primary", "foreground": "$token.color.onPrimary", "radius": 16, "paddingV": 15, "paddingH": 24 },
    "secondary": { "background": "$token.color.surface", "foreground": "$token.color.primary", "radius": 16, "paddingV": 15, "paddingH": 24 },
    "tinted": { "background": "$token.color.primarySoft", "foreground": "$token.color.primary", "radius": 16, "paddingV": 15, "paddingH": 24 },
    "destructive": { "background": "$token.color.error", "foreground": "#FFFFFF", "radius": 16, "paddingV": 15, "paddingH": 24 },
    "pill": { "background": "$token.color.primary", "foreground": "$token.color.onPrimary", "radius": 999, "paddingV": 15, "paddingH": 28 },
    "small": { "background": "$token.color.primary", "foreground": "$token.color.onPrimary", "radius": 12, "paddingV": 9, "paddingH": 16 },
    "large": { "background": "$token.color.primary", "foreground": "$token.color.onPrimary", "radius": 18, "paddingV": 18, "paddingH": 28 }
  }
}
