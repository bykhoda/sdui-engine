                    "top": "$token.spacing.xs",
                    "bottom": "$token.spacing.md"
                  }
                },
                "children": [
                  {
                    "type": "vstack",
                    "alignment": "center",
                    "spacing": "$token.spacing.xs",
                    "modifiers": {
                      "size": {
                        "width": {
                          "mode": "weight",
                          "value": 1
                        }
                      }
                    },
                    "children": [
                      {
                        "type": "vstack",
                        "children": [],
                        "modifiers": {
                          "size": {
                            "width": {
                              "mode": "fill"
                            },
                            "height": {
                              "mode": "fixed",
                              "value": 52
                            }
                          },
                          "background": "$token.color.primary",
                          "cornerRadius": "$token.radius.md"
                        }
                      },
                      {
                        "type": "text",
                        "value": "primary",
                        "style": "$token.typography.caption",
                        "color": "$token.color.textSecondary"
                      }
                    ]
                  },
                  {
                    "type": "vstack",
                    "alignment": "center",
                    "spacing": "$token.spacing.xs",
                    "modifiers": {
                      "size": {
                        "width": {
                          "mode": "weight",
                          "value": 1
                        }
                      }
                    },
                    "children": [
                      {
                        "type": "vstack",
                        "children": [],
                        "modifiers": {
                          "size": {
                            "width": {
                              "mode": "fill"
                            },
                            "height": {
                              "mode": "fixed",
                              "value": 52
                            }
                          },
                          "background": "$token.color.success",
                          "cornerRadius": "$token.radius.md"
                        }
                      },
                      {
                        "type": "text",
                        "value": "success",
                        "style": "$token.typography.caption",
                        "color": "$token.color.textSecondary"
                      }
                    ]
                  },
                  {
                    "type": "vstack",
                    "alignment": "center",
                    "spacing": "$token.spacing.xs",
                    "modifiers": {
                      "size": {
                        "width": {
                          "mode": "weight",
                          "value": 1
                        }
                      }
                    },
                    "children": [
                      {
                        "type": "vstack",
                        "children": [],
                        "modifiers": {
                          "size": {
                            "width": {
                              "mode": "fill"
                            },
                            "height": {
                              "mode": "fixed",
                              "value": 52
                            }
                          },
                          "background": "$token.color.warning",
                          "cornerRadius": "$token.radius.md"
                        }
                      },
                      {
                        "type": "text",
                        "value": "warning",
                        "style": "$token.typography.caption",
                        "color": "$token.color.textSecondary"
                      }
                    ]
                  },
                  {
                    "type": "vstack",
                    "alignment": "center",
                    "spacing": "$token.spacing.xs",
                    "modifiers": {
                      "size": {
                        "width": {
                          "mode": "weight",
                          "value": 1
                        }
                      }
                    },
                    "children": [
                      {
                        "type": "vstack",
                        "children": [],
                        "modifiers": {
                          "size": {
                            "width": {
                              "mode": "fill"
                            },
                            "height": {
                              "mode": "fixed",
                              "value": 52
                            }
                          },
                          "background": "$token.color.error",
                          "cornerRadius": "$token.radius.md"
                        }
                      },
