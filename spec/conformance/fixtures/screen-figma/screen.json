                        "style": "$token.typography.caption",
                        "color": "$token.color.textSecondary"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "text",
                "value": "TYPE",
                "style": "$token.typography.caption",
                "color": "$token.color.textSecondary"
              },
              {
                "type": "vstack",
                "alignment": "leading",
                "spacing": "$token.spacing.sm",
                "modifiers": {
                  "padding": {
                    "top": "$token.spacing.xs"
                  }
                },
                "children": [
                  {
                    "type": "text",
                    "value": "Title",
                    "style": "$token.typography.title2",
                    "color": "$token.color.textPrimary"
                  },
                  {
                    "type": "text",
                    "value": "Headline — group labels",
                    "style": "$token.typography.headline",
                    "color": "$token.color.textPrimary"
                  },
                  {
                    "type": "text",
                    "value": "Body — the everyday reading size for content and controls.",
                    "style": "$token.typography.body",
                    "color": "$token.color.textPrimary"
                  },
                  {
                    "type": "text",
                    "value": "CAPTION — metadata",
                    "style": "$token.typography.caption",
                    "color": "$token.color.textSecondary"
